# Copy this file to `.env` (same folder) and fill in what you need. Never commit `.env`.

# Claude writes each clip's hook, title, reason and hashtags. Without a key, ClipForge
# uses the clip's strongest opening line from the transcript instead.
ANTHROPIC_API_KEY=

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# WHISPER_MODEL=medium        # tiny | base | small | medium | large-v3 (default: medium on GPU, small on CPU)
# WHISPER_DEVICE=auto         # auto | cuda | cpu
